# ─────────────────────────────────────────────────────────────────────────────
# ATLAS-OPS — Local Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and update the values for your local setup:
#   copy .env.example .env

# ── Application ──────────────────────────────────────────────────────────────
APP_ENV=development
APP_NAME=ATLAS-OPS
SECRET_KEY=atlas_ops_local_secret

# ── Database (Local PostgreSQL via pgAdmin) ──────────────────────────────────
# Format: postgresql+asyncpg://USERNAME:PASSWORD@HOST:PORT/DATABASE
# Update USERNAME and PASSWORD to match your local pgAdmin/PostgreSQL setup
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/atlas_ops

# ── Redis (Docker) ───────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Fraud Detection ─────────────────────────────────────────────────────────
FRAUD_THRESHOLD=0.65

# ── Circuit Breaker ─────────────────────────────────────────────────────────
CIRCUIT_BREAKER_FAIL_MAX=5
CIRCUIT_BREAKER_RESET_TIMEOUT=60

# ── ML Model Paths ──────────────────────────────────────────────────────────
FRAUD_MODEL_PATH=app/ml_models/fraud_model.pkl
FAILURE_MODEL_PATH=app/ml_models/failure_model.pkl
ROUTING_MODEL_PATH=app/ml_models/routing_model.pkl

# ── LLM / RAG (Optional — works without it using template fallback) ─────────
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Gateway URLs (simulated — no real calls made) ───────────────────────────
STRIPE_URL=https://api.stripe.com/mock
RAZORPAY_URL=https://api.razorpay.com/mock
PAYPAL_URL=https://api.paypal.com/mock
SQUARE_URL=https://api.squareup.com/mock

# ── Idempotency ─────────────────────────────────────────────────────────────
IDEMPOTENCY_TTL_SECONDS=86400
